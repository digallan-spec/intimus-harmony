# Número comercial do WhatsApp da Clínica Umana conectado ao Kommo
# Formato internacional somente números: DDI (55) + DDD + Número (ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL canônica do site publicado (usada em Open Graph e SEO)
NEXT_PUBLIC_SITE_URL=https://intimus-harmony.clinicaumana.com.br

# Controle público de exibição de preços no FAQ (true | false)
# A publicação do valor depende de validação das regras de publicidade profissional da clínica.
NEXT_PUBLIC_SHOW_PUBLIC_PRICE=true
NEXT_PUBLIC_SHOW_EVALUATION_PRICE=false

# Registro profissional da responsável técnica (ex.: CREFITO-3/XXXXXX-F)
# Deixe vazio até confirmação oficial.
NEXT_PUBLIC_PROFESSIONAL_REGISTRY=

# Analytics (opcionais — preencher somente com IDs oficiais)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
